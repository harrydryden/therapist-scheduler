# Environment
NODE_ENV=development

# Server
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/therapist_scheduling

# Redis
REDIS_URL=redis://localhost:6379

# Distributed Locking
# Set to 'true' if running a single instance without Redis for distributed locks.
# When false (default), background services refuse to start if Redis is unavailable,
# preventing duplicate processing in multi-instance deployments.
# SINGLE_INSTANCE_MODE=false

# JWT (generate a secure random string)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# AI Services (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Webhooks
WEBHOOK_SECRET=your-webhook-secret-here

# Rate Limiting (optional - defaults shown)
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=60000

# CORS (optional)
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Public URLs for generating links in outbound mail
# - BACKEND_URL is used for routes served by the backend (unsubscribe, ATS).
# - FRONTEND_URL is used for routes served by the frontend (signup,
#   invitation acceptance, public booking landing).
# Both are validated as non-localhost when NODE_ENV=production.
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Logging (optional)
LOG_LEVEL=info

# Frontend (for Vite)
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Number of trusted proxy hops in front of the app. Drives both Fastify's
# trustProxy (so per-IP rate limits key on the real client, not the proxy)
# and the admin brute-force limiter's client-IP extraction. Railway adds one
# hop; if public traffic also comes through the Vercel /api rewrite, set 2.
# TRUSTED_PROXY_DEPTH=1

# ---------------------------------------------------------------------------
# Gmail (transport) — one of the two credential forms is required
# ---------------------------------------------------------------------------
# Base64-encoded OAuth client credentials JSON and token JSON (preferred on
# Railway; see packages/backend/scripts/reauthorize-gmail.ts to mint a token).
# GMAIL_CREDENTIALS_BASE64=
# GMAIL_TOKEN_BASE64=
# ...or file paths to the same JSON documents (local development).
# MCP_GMAIL_CREDENTIALS_PATH=
# MCP_GMAIL_TOKEN_PATH=
# The mailbox address the scheduler sends from / receives on. It must match
# the Gmail account's address (a mismatch logs an error at boot) and is the
# single source for "our own address" checks on inbound mail.
# EMAIL_FROM_ADDRESS=scheduling@spill.chat
# Background cadences (ms). Defaults: poll 3 min, watch renewal 6 days,
# pending-email processor 2 min.
# EMAIL_POLL_INTERVAL_MS=180000
# GMAIL_WATCH_RENEWAL_INTERVAL_MS=518400000
# PENDING_EMAIL_INTERVAL_MS=120000

# ---------------------------------------------------------------------------
# Gmail push notifications (Google Cloud Pub/Sub) — see README for setup
# ---------------------------------------------------------------------------
# GOOGLE_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# Audience configured on the push subscription's OIDC token (usually the
# webhook URL). REQUIRED in production whenever GOOGLE_PUBSUB_TOPIC is set:
# without it the webhook rejects every push (401) and inbound mail arrives
# only via the 3-minute poll.
# GOOGLE_PUBSUB_AUDIENCE=https://<backend-host>/api/webhooks/gmail/push
# Never set to false in production (unauthenticated pushes are accepted).
# REQUIRE_PUBSUB_AUTH=true

# ---------------------------------------------------------------------------
# Slack alerts
# ---------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=
# Optional separate channel for high/critical severity alerts.
# SLACK_WEBHOOK_URL_URGENT=
# Base URL used to deep-link appointments from Slack alerts.
# ADMIN_DASHBOARD_URL=https://free.spill.app/admin

# ---------------------------------------------------------------------------
# Tokens & timezone
# ---------------------------------------------------------------------------
# Previous JWT_SECRET values (comma-separated) kept during key rotation so
# already-issued unsubscribe / voucher / feedback tokens keep verifying.
# HMAC_KEYS_OLD=
# Platform timezone for prompt rendering and admin date formatting.
# TIMEZONE=Europe/London

# ---------------------------------------------------------------------------
# Serving the SPA from the backend (optional; Vercel serves it in prod)
# ---------------------------------------------------------------------------
# Absolute path to a frontend build containing index.html. When unset the
# server probes /app/dist (Docker) then packages/frontend/dist.
# FRONTEND_DIST_DIR=

# ---------------------------------------------------------------------------
# Tuning (defaults shown; all optional)
# ---------------------------------------------------------------------------
# SSE_HEARTBEAT_INTERVAL=30000
# SSE_MAX_CONNECTIONS=100
# TOKEN_BUCKET_CAPACITY=200
# TOKEN_BUCKET_REFILL_RATE=20
# TOKEN_BUCKET_REFILL_INTERVAL=1000
# MAX_CONNECTIONS_PER_USER=3
# MAX_TOTAL_CONNECTIONS=50
# CONNECTION_TIMEOUT=300000
# PERFORMANCE_MONITORING=true
# PERFORMANCE_LOG_INTERVAL=300000
# PERFORMANCE_MAX_SAMPLES=100
# SLOW_QUERY_THRESHOLD=1000
# SLOW_MESSAGE_THRESHOLD=5000
# SLOW_AI_THRESHOLD=30000

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Postgres for `npm run test:integration` (never point this at production).
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/therapist_scheduling_test
